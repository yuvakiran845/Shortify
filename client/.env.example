# Frontend settings for DEVELOPMENT (copy to client/.env, optional).
#
# Base URL of the Shortify API. Its routes start with /api.
# Leave it as /api in development: Vite forwards /api to http://127.0.0.1:5000
# (see vite.config.js), so the browser sees one address and no CORS is needed.
VITE_API_BASE_URL=/api

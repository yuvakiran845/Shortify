# Copy this file to .env and adjust the values. Never commit the real .env file.

# Port the API listens on
PORT=5000
NODE_ENV=development

# MongoDB connection string (local MongoDB or a MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/shortify

# Public address short links are built from: <PUBLIC_BASE_URL>/<code>, e.g. http://localhost:5000/aB7xK9p
# Development: http://localhost:5000 (links open on this computer only).
# Production: the public HTTPS address of this server, e.g. https://YOUR-PROJECT.vercel.app
#   (required in production; the server refuses localhost or private IP addresses there).
# Optional: "npm run lan" switches to this computer's Wi-Fi address for testing on phones.
PUBLIC_BASE_URL=http://localhost:5000

# Frontend origin(s) allowed to call the API, comma-separated.
# Not needed when this server also serves the website (CLIENT_DIST_DIR below).
CLIENT_ORIGIN=http://localhost:5173

# Optional: serve the built React app from this server (one public address for
# the website, the API, and short links). Path to client/dist after "npm run build".
# CLIENT_DIST_DIR=../client/dist

# Cookie SameSite: "lax" (default). Use "none" only if the website is on a different
# site and calls the API directly (production/HTTPS only).
# COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of the API (0 locally, 1 on Vercel or Render)
TRUST_PROXY=0

# Max API requests one IP address can make per minute (all endpoints together)
API_LIMIT_PER_MINUTE=300

# Max links one IP address can create per minute
CREATE_LINK_LIMIT_PER_MINUTE=20

# Max short-link redirects one IP address can open per minute (blocks code scanning)
REDIRECT_LIMIT_PER_MINUTE=120

# Repeat clicks by the same visitor on the same link within this many seconds count once
CLICK_DEDUPE_SECONDS=30

# Secret used to sign login sessions (JWT). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# How long a login lasts
SESSION_DAYS=7

# bcrypt cost factor for password hashing (12 recommended; each +1 doubles the work)
BCRYPT_ROUNDS=12

# Failed login attempts allowed per IP address every 15 minutes
LOGIN_LIMIT_PER_15_MINUTES=10

# Accounts one IP address can register per hour
REGISTER_LIMIT_PER_HOUR=10

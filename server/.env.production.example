# PRODUCTION settings for the API. Enter these in your host's dashboard
# (Vercel → your project → Settings → Environment Variables). Do NOT create a
# real .env file with these values in the repository, and never commit real secrets.
#
# Values in <ANGLE BRACKETS> are placeholders you must replace.

NODE_ENV=production

# The host sets PORT automatically (Vercel and Render); do not set it there.
# PORT=10000

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name "shortify":
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/shortify?retryWrites=true&w=majority

# The public HTTPS address of the deployment. Short links become <PUBLIC_BASE_URL>/<code>.
PUBLIC_BASE_URL=https://<YOUR-PROJECT>.vercel.app

# The website's address. On Vercel the website and the API share one address,
# so this is the same as PUBLIC_BASE_URL (comma-separate several addresses).
CLIENT_ORIGIN=https://<YOUR-PROJECT>.vercel.app

# At least 32 random characters. To make one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<LONG-RANDOM-SECRET>

# Vercel (and Render) run one proxy in front of the app.
TRUST_PROXY=1

# --- Only for other deployment options (see README → Deployment) ---
# Option B, one Render service: Express also serves the website (path relative to
# the repository root). Do not set this on Vercel, which serves the website itself.
# CLIENT_DIST_DIR=client/dist
# Option C, website on another site calling the API directly (HTTPS only):
# COOKIE_SAME_SITE=none

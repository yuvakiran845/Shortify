# PRODUCTION settings for the API. Enter these in your host's dashboard
# (Render → your service → Environment). Do NOT create a real .env file with
# these values in the repository, and never commit real secrets.
#
# Values in <ANGLE BRACKETS> are placeholders you must replace.

NODE_ENV=production

# Render sets PORT automatically; do not set it there.
# PORT=10000

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name "shortify":
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/shortify?retryWrites=true&w=majority

# The public HTTPS address of THIS server. Short links become <PUBLIC_BASE_URL>/<code>.
PUBLIC_BASE_URL=https://<YOUR-SERVICE>.onrender.com

# One-service deployment (recommended): this server also serves the website.
# Path is relative to where the server starts (the repository root on Render).
CLIENT_DIST_DIR=client/dist

# Only when the website is hosted separately (e.g. Netlify): its address, and
# COOKIE_SAME_SITE=none if it calls the API directly instead of through a proxy.
# CLIENT_ORIGIN=https://<YOUR-SITE>.netlify.app
# COOKIE_SAME_SITE=none

# At least 32 random characters. On Render the Blueprint generates it for you. To make one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<LONG-RANDOM-SECRET>

# Render runs one proxy in front of the app.
TRUST_PROXY=1

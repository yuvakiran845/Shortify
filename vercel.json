{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server --omit=dev && npm ci --prefix client --include=dev",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(login|signup|shorten|qr|dashboard|links)", "destination": "/index.html" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/:code([A-Za-z0-9_-]+)", "destination": "/api" }
  ]
}
